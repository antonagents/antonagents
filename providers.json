    "pricing": {
      "claude-sonnet-5-5": {
        "input": 2.0,
        "output": 10.0,
        "cache_read": 0.1,
        "cache_write": 2.5
      }
    },
    "vision": true,
    "headers_env": {
      "anthropic-workspace-id": "ANTHROPIC_WORKSPACE_ID"
    }
  },
