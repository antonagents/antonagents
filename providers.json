[
  {
    "name": "anthropic",
    "label": "Anthropic (Claude)",
    "base_url": null,
    "auth_env": "ANTHROPIC_API_KEY",
    "token_target": "ANTHROPIC_API_KEY",
    "models": [
      "claude-sonnet-5-5",
      "claude-opus-5-5",
      "claude-sonnet-5",
      "claude-haiku-4-5-20251001",
      "claude-opus-4-8"
