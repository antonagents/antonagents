# Copy to .env and fill in. The server reads these from its environment.

# --- LLM providers -------------------------------------------------------
# Set the key(s) for the provider(s) you want available. At least one required.
# The router picks a provider+model per task; each task's container gets ONLY
# the chosen provider's endpoint + key injected.

# Anthropic (Claude) — native endpoint.
ANTHROPIC_API_KEY=

# Z.ai (GLM, incl. GLM-5.2) — Anthropic-compatible endpoint, no extra config.
ZAI_API_KEY=

# OpenAI / other non-Anthropic models via the optional LiteLLM gateway
# (`docker compose --profile litellm up`). Two keys — see the README section
# "Using OpenAI / other models via LiteLLM":
#   OPENAI_API_KEY     — your REAL OpenAI key; used ONLY by the LiteLLM gateway,
#                        never seen by Antonagents or the task containers.
#   OPENAI_GATEWAY_KEY — a secret you choose; it is the gateway's master key AND
#                        what Antonagents uses to authenticate to the gateway.
OPENAI_API_KEY=
OPENAI_GATEWAY_KEY=

# Which provider the router falls back to when a task doesn't pick one.
SUPERAGENT_DEFAULT_PROVIDER=anthropic

# Optional: override the built-in provider set / routing rules with JSON files.
# SUPERAGENT_PROVIDERS_FILE=./providers.json
# SUPERAGENT_ROUTING_FILE=./routing.json

# Task image built from docker/Dockerfile.task
SUPERAGENT_TASK_IMAGE=superagent-task:latest

# How many task containers may run at once.
SUPERAGENT_MAX_CONCURRENT=3

# Per-run wall-clock timeout (seconds) before the container is killed.
SUPERAGENT_TASK_TIMEOUT=3600

# Ceiling on agent turns per run.
SUPERAGENT_MAX_TURNS=60

# Programmatic API (/v1) per-key rate limit: sustained requests/minute (token
# bucket; burst up to _BURST, which defaults to _PER_MIN). Set 0 to disable.
SUPERAGENT_V1_RATE_PER_MIN=120
# SUPERAGENT_V1_RATE_BURST=120

# Per-container resource limits.
SUPERAGENT_TASK_MEMORY=2g
SUPERAGENT_TASK_CPUS=2
SUPERAGENT_TASK_PIDS=512
SUPERAGENT_TASK_NETWORK=bridge

# API server bind.
SUPERAGENT_HOST=0.0.0.0
SUPERAGENT_PORT=8080

# --- auth / multi-tenant --------------------------------------------------
# The API requires a logged-in user; every task/workspace is owned by its
# creator and invisible to everyone else.

# Signs the session cookie AND keys the at-rest encryption of data-source
# credentials and agent env. Set a long, random, STABLE value in prod and back it
# up: if it changes, encrypted data becomes unrecoverable (and in-flight Google
# logins break on restart). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUPERAGENT_SESSION_SECRET=
# Session lifetime (hours) and whether to mark the cookie Secure (set true behind https).
SUPERAGENT_SESSION_TTL_HOURS=720
SUPERAGENT_COOKIE_SECURE=false

# Signup gating. "open" (default) allows self-signup — right for self-hosting.
# "invite" requires a pending invitation for the email before an account can be
# created (password or Google) — use this on a shared/hosted instance to control
# who consumes its compute and your provider-key spend. Invite people from the
# Members view; they register with the invited email.
SUPERAGENT_SIGNUP=open

# Instance operators (comma-separated emails). Operators can generate self-serve
# "signup links" from the Members view that onboard a NEW team: whoever registers
# with the link gets their OWN fresh workspace (as its admin), not the operator's
# org. Regular org admins can only invite teammates into their own org. If unset,
# any org admin may create signup links (fine for self-hosting); set this on a
# shared hosted instance so only you can onboard new teams.
SUPERAGENT_OPERATORS=

# Optional Google (Gmail) login. Create an OAuth 2.0 Web client in Google Cloud;
# set the authorized redirect URI to GOOGLE_REDIRECT_URI below. If either id or
# secret is blank, the Google button is hidden and email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# --- connectors (SaaS integrations: Slack / Linear / Gmail ...) -----------
# Managed via Composio. Set the API key to enable the Connections UI. Users then
# connect their own accounts (OAuth); the agent gets per-user tools via MCP.
SUPERAGENT_CONNECTORS_PROVIDER=composio
# SECURITY: leave blank unless every user on this instance is trusted. Setting a
# key enables connectors, which inject an org-wide key into agent-controlled task
# containers (exfil risk). See docs/SECURITY.md.
COMPOSIO_API_KEY=
# Where Composio returns users after OAuth (a small "connected" page that closes
# the popup and refreshes the console). Match the host your browser uses.
COMPOSIO_REDIRECT_URI=http://localhost:8080/connected
# Optional: explicit auth-config ids (ac_...) for custom / production OAuth apps.
# Leave blank in dev — Composio auto-creates managed auth configs on first connect.
COMPOSIO_AUTHCONFIG_SLACK=
COMPOSIO_AUTHCONFIG_LINEAR=
COMPOSIO_AUTHCONFIG_GMAIL=
